# ─── Local Docker PostgreSQL ────────────────────────────────────────────────
# DATABASE_URL=postgres://postgres:password@localhost:5432/poker_db

# ─── Supabase (replace with your project values) ────────────────────────────
# Get from: Supabase Dashboard > Project Settings > Database > Connection pooling
# Recommended: Transaction pooler (port 6543) — better concurrency for production
#   Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Alternative: Direct connection (port 5432) — required for db:migrate / drizzle-kit
#   Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Server
PORT=3000

# Auth — generate a strong random secret (32+ chars)
BETTER_AUTH_SECRET=your_very_secret_key

VITE_API_URL=http://localhost:3000