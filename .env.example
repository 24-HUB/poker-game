NODE_ENV=development
PORT=3001
PUBLIC_ORIGIN=http://localhost:3000
BACKEND_ORIGIN=http://localhost:3001
PROXY_SECRET=replace-with-a-long-random-value
MONGODB_URI=mongodb://127.0.0.1:27018/poker?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=poker
TEST_MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
REGISTRATION_INVITE_CODE_SHA256=replace-with-a-sha256-hex-digest
# M3 account email delivery (configure before enabling verification/reset)
BREVO_API_KEY=replace-with-a-server-only-brevo-key
BREVO_SENDER_EMAIL=sender-you-control@example.com
BREVO_SENDER_NAME=Looking Glass Club
