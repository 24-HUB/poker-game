# ─── Local Docker PostgreSQL ────────────────────────────────────────────────
# DATABASE_URL=postgres://postgres:password@localhost:5432/poker_db

# ─── Supabase (replace with your project values) ────────────────────────────
# Get from: Supabase Dashboard > Project Settings > Database > Connection string
# Use the "URI" format (direct connection — NOT the pooler URL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Server
PORT=3000

# Auth — generate a strong random secret (32+ chars)
BETTER_AUTH_SECRET=your_very_secret_key

VITE_API_URL=http://localhost:3000